# OpenAI API Key
OPENAI_API_KEY=여기에_API_KEY_입력

# LLM / Embedding model
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=edu_ai_demo

# Chroma VectorDB 저장 위치
CHROMA_DIR=./chroma_db

# API Key 없이 수업 흐름만 확인하고 싶으면 true
# true이면 LLM 호출 대신 규칙 기반 샘플 답변을 출력합니다.
USE_FAKE_LLM=false
